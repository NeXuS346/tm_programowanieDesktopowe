<Window x:Class="tm_programowanieDesktopowe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:tm_programowanieDesktopowe"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0" Grid.Column="1" >Login</Label>
        <TextBox Name="txLogin" Grid.Row="0" Grid.Column="2" 
                Text="{Binding VLogin, UpdateSourceTrigger=PropertyChanged}" />
        <Label Grid.Row="1" Grid.Column="1" >Password</Label>

        <TextBox Name="txPass" Grid.Row="1" Grid.Column="2"/>
        <Button Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Click="Btn_login">Login</Button>


    </Grid>
</Window>